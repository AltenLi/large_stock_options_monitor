# V2多市场期权监控系统环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# 富途API配置
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_UNLOCK_PWD=your_trading_password

# FutuOpenD 登录配置
FUTU_LOGIN_ACCOUNT=100000
FUTU_LOGIN_PWD_MD5=123456

# 企业微信机器人配置
WEWORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key

# 邮件通知配置
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# 时区设置
TZ=Asia/Shanghai